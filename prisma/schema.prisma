generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Prisma 7 no longer reads it from the schema)
datasource db {
  provider = "postgresql"
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum SessionStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
}

// Recruiter accounts start as PENDING_APPROVAL until an admin approves them
enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role     @default(CANDIDATE)
  status       UserStatus @default(ACTIVE)
  resumeUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  candidateSessions InterviewSession[] @relation("CandidateSessions")
  recruiterSessions InterviewSession[] @relation("RecruiterSessions")
  notifications     Notification[]

  @@map("users")
}

model InterviewSession {
  id                   String        @id @default(uuid())
  candidateId          String
  recruiterId          String?
  jobTitle             String
  jobDescription       String?
  resumeText           String?
  status               SessionStatus @default(SCHEDULED)
  codeState            String?       @default("// Welcome to the Live Interview Session\n// Write your code here\n")
  currentQuestionIndex Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  candidate User  @relation("CandidateSessions", fields: [candidateId], references: [id], onDelete: Cascade)
  recruiter User? @relation("RecruiterSessions", fields: [recruiterId], references: [id], onDelete: SetNull)

  questions Question[]
  results   Result[]

  @@map("interview_sessions")
}

model Question {
  id        String  @id @default(uuid())
  sessionId String
  text       String
  type       String? // "theoretical" | "coding" | "design" (as produced by the AI service)
  topic      String?
  difficulty String?
  order      Int
  // Everything else the AI/recruiter attached: skills, estimated_time, based_on, testCases, ...
  meta       Json?

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answer  Answer?

  @@index([sessionId, order])
  @@map("questions")
}

model Answer {
  id            String  @id @default(uuid())
  questionId    String  @unique
  answerText    String?
  submittedCode String?
  language      String?
  // AI evaluation output, stored exactly as the AI service returned it
  feedback       Json? // AI-006 answer feedback (score 0-10)
  codeEvaluation Json? // AI-005 code evaluation (score 0-100)
  followUp       Json? // AI-004 follow-up decision
  // Normalised 0-100 score used for analytics (null until evaluated)
  score          Float?
  createdAt      DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answers")
}

model Result {
  id        String   @id @default(uuid())
  sessionId String
  score          Float
  feedback       String
  recommendation String?
  // Full AI-007 final report
  report         Json?
  createdAt      DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("results")
}

// In-app notifications: interview scheduled/completed, feedback ready, announcements
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

// One row per call to the AI service, used for AI reliability/integrity monitoring
model AiCallLog {
  id        String   @id @default(uuid())
  feature   String
  ok        Boolean
  latencyMs Int
  attempts  Int      @default(1)
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("ai_call_logs")
}

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database Connection (Supabase, Railway, Neon, or Local PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/interviewai?schema=public"

# JWT Authentication
JWT_SECRET="super-secret-jwt-signing-key-minimum-32-chars-long"
JWT_EXPIRES_IN="7d"

# Optional: Supabase & AI Services (For Phase 3 & 4)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=

# Server Configuration
PORT=5000
NODE_ENV=development
# Comma-separated allowed origins, e.g. http://localhost:3000,https://app.example.com  ("*" = any)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection (Supabase, Railway, Neon, or Local PostgreSQL)
# Leave unset in development to use in-memory storage (data lost on restart). Required in production.
# After setting it, run: npm run prisma:migrate
DATABASE_URL="postgresql://postgres:password@localhost:5432/interviewai?schema=public"

# JWT Authentication (REQUIRED, at least 32 characters)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN="7d"

# Demo without a database: with DATABASE_URL unset, this admin is created in memory at startup
# DEV_ADMIN_EMAIL=admin@example.com
# DEV_ADMIN_PASSWORD=ChangeMe12345

# Code runner: build the sandbox image with ./build_runner.sh and keep Docker running.
# Only for local development without Docker: run candidate code directly on this machine (NOT sandboxed).
# ALLOW_UNSANDBOXED_RUNNER=true

# AI service (the ai-service/ app: run it separately; it needs its own GROQ_API_KEY in ai-service/.env)
AI_SERVICE_URL=http://localhost:3000
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_RETRIES=1
AI_RATE_LIMIT_PER_MINUTE=30
